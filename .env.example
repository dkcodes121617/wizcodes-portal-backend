# Copy this file to .env and fill in DATABASE_URL. That is the only required line.
#
#     cp .env.example .env        (macOS/Linux)
#     copy .env.example .env      (Windows)
#
# Why so short: the app detects where it is running. On Render it sets itself to
# production (DEBUG off, reload off, keep-alive on); anywhere else it runs in
# development mode. You only override a value when you actually want something
# different from the default.
#
# In production these are Render environment variables — no .env is deployed.
# Never commit real secrets; this file holds placeholders only.

# =============================================================================
# REQUIRED
# =============================================================================

# Neon dashboard -> your project -> Connection string. Keep ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# =============================================================================
# OPTIONAL — every line below is commented out and shows its effective default
# =============================================================================

# --- app ---
# PROJECT_NAME=WizCodes Portal API
# ENVIRONMENT=development          # auto: production when RENDER is set, else development
# DEBUG=true                       # auto: true outside production. Must be false in production.
# API_V1_PREFIX=/api/v1

# --- server ---
# HOST=0.0.0.0                     # bind all interfaces; required on Render
# PORT=8000                        # Render injects its own PORT — do not set it there
# RELOAD=true                      # auto: true outside production. Must be false in production.
# LOG_LEVEL=INFO                   # CRITICAL | ERROR | WARNING | INFO | DEBUG

# --- security ---
# Auto-generated locally. REQUIRED in production, otherwise every restart
# invalidates previously issued tokens (the app refuses to boot without it).
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# ENABLE_DOCS=true                 # set false to hide /docs on a public deployment

# --- CORS ---
# "*" allows every origin. Browsers refuse to honour "*" together with
# credentialed requests, so CORS_ALLOW_CREDENTIALS must stay false while
# CORS_ORIGINS is "*". Bearer tokens in the Authorization header are unaffected.
# CORS_ORIGINS=*
# CORS_ALLOW_CREDENTIALS=false

# --- the single frontend <-> backend link ---
# Auto-detected: https://wizcodes-portal-frontend.vercel.app on Render,
# http://localhost:3000 anywhere else. Set it only for a custom domain.
# FRONTEND_URL=http://localhost:3000

# --- keep-alive (Render free tier sleeps after ~15 min idle) ---
# Only runs in production with a public URL, so it is inert locally.
# KEEPALIVE_ENABLED=true
# KEEPALIVE_INTERVAL_SECONDS=840   # 14 minutes
# PUBLIC_BASE_URL=                 # auto: RENDER_EXTERNAL_URL, else the deployed URL

# --- database tuning ---
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE_SECONDS=300      # Neon drops idle connections; recycle before it does
# DB_ECHO=false                    # true logs every SQL statement (development only)
